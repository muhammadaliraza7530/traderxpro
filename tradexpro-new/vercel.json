{
  "version": 2,
  "buildCommand": "python build_frontend.py",
  "installCommand": "pip install -r requirements.txt",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/$", "dest": "/index.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/signup", "dest": "/signup.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/register.html", "dest": "/register.html" },
    { "src": "/privacy-policy", "dest": "/privacy-policy.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/profile", "dest": "/profile.html" },
    { "src": "/profile.html", "dest": "/profile.html" },
    { "src": "/kyc.html", "dest": "/profile-feature.html" },
    { "src": "/security.html", "dest": "/profile-feature.html" },
    { "src": "/transfer.html", "dest": "/profile-feature.html" },
    { "src": "/referral.html", "dest": "/profile-feature.html" },
    { "src": "/transactions.html", "dest": "/wallets.html" },
    { "src": "/markets", "dest": "/markets.html" },
    { "src": "/markets.html", "dest": "/markets.html" },
    { "src": "/staking", "dest": "/staking.html" },
    { "src": "/staking.html", "dest": "/staking.html" },
    { "src": "/trading/BTC", "dest": "/trading.html" },
    { "src": "/bot-trade", "dest": "/bot-trade.html" },
    { "src": "/wallets", "dest": "/wallets.html" },
    { "src": "/help-and-support", "dest": "/help-support.html" },
    { "src": "/support.html", "dest": "/help-support.html" },
    { "src": "/deposit", "dest": "/deposit-methods.html" },
    { "src": "/withdraw", "dest": "/withdraw-methods.html" },
    { "src": "/withdraw/confirm/7", "dest": "/withdraw-confirm.html" },
    { "src": "/deposit/checkout/1", "dest": "/deposit-checkout.html" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/logo/(.*)", "dest": "/logo/$1" },
    { "src": "/public/(.*)", "dest": "/public/$1" }
  ]
}
